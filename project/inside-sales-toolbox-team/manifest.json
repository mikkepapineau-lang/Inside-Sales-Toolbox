{
  "manifest_version": 3,
  "name": "Solotech · Inside Sales Toolbox",
  "version": "3.5.11",
  "description": "Outils ventes internes : Salesforce, coordonnées D365, produits neufs et usagés, calculateur de marge et devises, commandes et codes HS.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel",
    "tabGroups"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inside Sales Toolbox",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "clipboardWrite"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
